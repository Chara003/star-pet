<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="me.rerere.pet"
    android:versionCode="2"
    android:versionName="1.1.0">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35"/>

    <application
        android:name=".PetApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_placeholder"
        android:roundIcon="@drawable/ic_launcher_placeholder"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <!-- 新主页（底栏四页）。旧 MainActivity 保留不删，作为重构期间的入口兜底。 -->
        <activity
            android:name=".ui.MainTabsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.PetSettingsActivity"
            android:exported="false"
            android:label="高级设置"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.MmdSettingsActivity"
            android:exported="false"
            android:label="MMD 设置"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density|smallestScreenSize|screenLayout"/>

        <activity
            android:name=".ui.PetMmdActivity"
            android:exported="false"
            android:label="3D 模型"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.PetExprActivity"
            android:exported="false"
            android:label="表情映射"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.SpriteLibraryActivity"
            android:exported="false"
            android:label="桌宠素材库"/>

        <activity
            android:name=".ui.MemoryActivity"
            android:exported="false"
            android:label="长期记忆"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.ModelPickerActivity"
            android:exported="false"
            android:label="模型与素材"/>

        <activity
            android:name=".ui.ProviderEditActivity"
            android:exported="false"
            android:label="AI 提供商"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.ColorPaletteActivity"
            android:exported="false"
            android:label="强调色"/>

        <activity
            android:name=".ui.PetAccessoryActivity"
            android:exported="false"
            android:label="配件装备"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.PetTranslateActivity"
            android:exported="false"
            android:label="名称翻译"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.PetVmdActivity"
            android:exported="false"
            android:label="VMD 动画"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.PetSearchActivity"
            android:exported="false"
            android:label="联网搜索"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.PetInteractActivity"
            android:exported="false"
            android:label="互动设置"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".ui.McpEditActivity"
            android:exported="false"
            android:label="MCP 服务器"
            android:windowSoftInputMode="adjustResize"/>

        <service
            android:name=".ui.PetOverlayService"
            android:exported="false"/>
    </application>
</manifest>
