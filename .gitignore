# 构建工具（自己准备，不进仓库；放项目根目录即可被 build.sh 自动找到）
/r8.jar
/keys/

# ============================================================
# 签名密钥（绝不上传）
#   keys/pet.jks 是本机自签名用的密钥库。
#   一旦泄露，别人就能签出同包名的"官方更新包"覆盖安装。
# ============================================================
keys/
*.jks
*.keystore
*.p12

# ============================================================
# 本地备份 / 历史快照
